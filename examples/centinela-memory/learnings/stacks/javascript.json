  "learnings": [
    {
      "id": "js-fetch-explicit-timeout",
      "scope": "stack",
      "stacks": ["javascript"],
      "paths": ["**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx"],
      "category": "freeze",
      "severity": "maintainer",
      "rule": "Always pass AbortSignal.timeout(...) to outbound fetch calls so a hung upstream cannot stall a worker or request indefinitely.",
      "status": "active",
      "stats": { "byRepo": {} }
    },
    {

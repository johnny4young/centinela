{
  "extends": null,
  "maintainers": [],
  "skipAuthors": ["dependabot[bot]", "renovate[bot]", "github-actions[bot]", "release-please[bot]"],
  "optInLabel": "triage",
  "overrideLabel": "triage: approved",
  "statusContext": "centinela",
  "license": null,
  "labels": {
    "waitingOnAuthor": { "name": "status: waiting-on-author", "color": "fbca04" },
    "needsMaintainer": { "name": "status: needs-maintainer", "color": "d93f0b" },
    "readyForMaintainer": { "name": "status: ready-for-maintainer", "color": "0e8a16" },
    "needsInfo": { "name": "needs-info", "color": "c5def5" },
    "aiReview": { "name": "centinela: ai-review", "color": "8b5cf6" },
    "aiTriage": { "name": "centinela: triage", "color": "0ea5e9" },
    "learn": { "name": "centinela: learn", "color": "14b8a6" },
    "size": {
      "XS": { "max": 10, "color": "3cbf00" },
      "S": { "max": 100, "color": "5d9801" },
      "M": { "max": 400, "color": "7f7203" },
      "L": { "max": 800, "color": "a14c05" },
      "XL": { "max": 1500, "color": "c32607" },
      "XXL": { "max": null, "color": "e50009" }
    }
  },
  "size": {
    "justifyFrom": "XL",
    "ignore": [
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/bun.lock",
      "**/bun.lockb",
      "**/Cargo.lock",
      "**/go.sum",
      "**/Package.resolved",
      "CHANGELOG.md",
      "**/__snapshots__/**",
      "**/*.snap"
    ]
  },
  "pullRequest": {
    "conventionalTitle": true,
    "singleLineTitle": "blocking",
    "requireScreenshots": "blocking",
    "sections": "template"
  },
  "paths": {
    "ui": ["**/*.tsx", "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.css", "**/*.scss", "**/*.html"],
    "source": [
      "src/**",
      "lib/**",
      "apps/*/src/**",
      "packages/*/src/**",
      "cmd/**",
      "internal/**",
      "pkg/**",
      "Sources/**"
    ],
    "tests": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/*_test.go",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/Tests/**",
      "e2e/**"
    ],
    "generated": ["**/migrations/meta/**", "**/__snapshots__/**", "**/*.snap"],
    "sensitive": []
  },
  "language": {
    "typos": true,
    "typosExclude": [],
    "typosIgnoreWords": [],
    "spanishRegister": null,
    "localeParity": null
  },
  "stack": "auto",
  "rules": {
    "electron": false,
    "workflows": true,
    "ui": false,
    "comments": false,
    "custom": []
  },
  "hygiene": {
    "checkConflicts": true,
    "maxBehindCommits": null,
    "migrations": "auto",
    "checkOverlap": true,
    "checkCi": true
  },
  "deps": {
    "minAgeDays": 14,
    "blockedLicenses": ["GPL", "AGPL", "LGPL", "SSPL"]
  },
  "ai": {
    "model": "claude-opus-5-5",
    "effort": "xhigh",
    "fastModel": "claude-sonnet-5-5",
    "fastEffort": "medium",
    "verifierModel": "claude-sonnet-5-5",
    "autoReview": "tiered",
    "deepFromSize": "L",
    "deepPaths": [],
    "agentic": true,
    "maxToolSteps": 6,
    "verify": true,
    "promptCaching": true,
    "maxInputTokens": 150000,
    "maxFileTokens": 60000,
    "maxRelatedTokens": 20000,
    "rules": ["AGENTS.md", "CLAUDE.md"],
    "inline": true
  },
  "learnings": {
    "enabled": true,
    "localPath": ".github/centinela/learnings.json",
    "shared": null,
    "shareScope": "public-only",
    "retireThreshold": 0.4,
    "retireMinSamples": 5,
    "weeklyPr": false
  },
  "conversation": {
    "enabled": true,
    "model": "claude-sonnet-5-5"
  },
  "lifecycle": {
    "remindAfterDays": 14,
    "closeAfterDays": null
  },
  "issues": {
    "productName": null,
    "bugLabel": "bug",
    "aiTriage": true,
    "aiModel": "claude-sonnet-5-5",
    "autoLabel": true,
    "detectDuplicates": true,
    "detectFixedInMain": true,
    "autoCloseFixed": true
  },
  "links": {
    "security": null,
    "rules": null,
    "contributing": null
  }
}
